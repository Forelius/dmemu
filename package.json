{
  "name": "dmemu",
  "version": "0.1.0",
  "type": "module",
  "description": "Depths Master Emulator — system-agnostic solo/GM emulator for Foundry VTT",
  "scripts": {
    "clean": "rimraf ./module",
    "build": "npm run clean && rollup -c",
    "buildd": "npx tsc",
    "lint": "eslint .",
    "packdump": "node scripts/build/LdbActions.mjs dump",
    "packrestore": "node scripts/build/LdbActions.mjs restore",
    "packextract": "node scripts/build/dbConvert.mjs extract",
    "packcompile": "node scripts/build/dbConvert.mjs compile",
    "decomppacks": "npm run packdump && npm run packextract && echo \"Decompiled packs\"",
    "comppacks": "npm run packcompile && npm run packrestore && echo \"Compiled packs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forelius/dmemu.git"
  },
  "keywords": [
    "foundry",
    "foundry-vtt",
    "solo",
    "emulator",
    "oracle",
    "osr"
  ],
  "author": "forelius",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Forelius/dmemu/issues"
  },
  "homepage": "https://github.com/Forelius/dmemu#readme",
  "dependencies": {
    "level": "^10.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "rollup": "^4.54.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
