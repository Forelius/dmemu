{
  "id": "dmemu",
  "title": "Depths Master Emulator",
  "description": "Depths Master Emulator (DMEmu) — a system-agnostic solo/GM emulator for Foundry VTT.",
  "version": "#{VERSION}#",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "forelius",
      "url": "https://github.com/Forelius",
      "discord": "forelius",
      "flags": {}
    }
  ],
  "esmodules": [
    "module/dmemu.min.js"
  ],
  "styles": [
    "css/dmemu.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json",
      "flags": {}
    }
  ],
  "packs": [
    {
      "name": "rollTables",
      "label": "DMEmu Roll Tables",
      "path": "packs/rollTables",
      "type": "RollTable",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "macros",
      "label": "DMEmu Macros",
      "path": "packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "journals",
      "label": "DMEmu Journals",
      "path": "packs/journals",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "changelog": "#{CHANGELOG}#",
  "readme": "README.md",
  "license": "LICENSE"
}
