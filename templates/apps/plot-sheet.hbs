{{!-- DMEmu Plot Sheet Application (campaign + plots) --}}
<section class="dmemu-oracle-form dmemu-plot-form">
  <p class="hint dmemu-plot-about">{{about}}</p>

  <nav class="dmemu-oracle-tabs" aria-label="{{localize "DMEMU.Plot.App.TabsLabel"}}">
    {{#each tabs}}
    <button type="button" class="{{#if active}}active{{/if}}" data-action="setTab" data-tab="{{id}}">
      {{label}}
    </button>
    {{/each}}
  </nav>

  {{#if isCampaignTab}}
  <div class="dmemu-plot-panel">
    <div class="dmemu-plot-sheet-stack">
      <fieldset>
        <legend>{{localize "DMEMU.Campaign.App.OpenLegend"}}</legend>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-campaign-select">{{localize "DMEMU.Campaign.App.Existing"}}</label>
          <div class="dmemu-plot-control-row">
            <select id="dmemu-campaign-select" name="campaignSelect">
              <option value="">{{localize "DMEMU.Campaign.App.SelectPlaceholder"}}</option>
              {{#each campaignList}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <button type="button" data-action="openCreateCampaignDialog" data-tooltip="{{localize "DMEMU.Campaign.App.NewCampaign"}}" aria-label="{{localize "DMEMU.Campaign.App.NewCampaign"}}">
              <i class="fas fa-plus"></i>
            </button>
          </div>
        </div>
      </fieldset>

      {{#if hasCampaign}}
      <fieldset>
        <legend>{{localize "DMEMU.Campaign.App.ActiveLegend"}}</legend>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-campaign-name">{{localize "DMEMU.Campaign.App.Name"}}</label>
          <input id="dmemu-campaign-name" type="text" name="campaignName" value="{{campaignName}}" />
        </div>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-plot-universe">{{localize "DMEMU.Campaign.App.Universe"}}</label>
          <textarea id="dmemu-plot-universe" name="universe" rows="3" placeholder="{{localize "DMEMU.Campaign.App.UniversePlaceholder"}}">{{universe}}</textarea>
          <p class="hint">{{localize "DMEMU.Campaign.App.UniverseHint"}}</p>
        </div>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-plot-protagonists">{{localize "DMEMU.Campaign.App.Protagonists"}}</label>
          <textarea id="dmemu-plot-protagonists" name="protagonists" rows="3" placeholder="{{localize "DMEMU.Campaign.App.ProtagonistsPlaceholder"}}">{{protagonists}}</textarea>
          <p class="hint">{{localize "DMEMU.Campaign.App.ProtagonistsHint"}}</p>
        </div>
        <div class="dmemu-oracle-actions dmemu-plot-sheet-save">
          <button type="button" data-action="saveCampaign">
            <i class="fas fa-save"></i> {{localize "DMEMU.Campaign.App.Save"}}
          </button>
        </div>
      </fieldset>
      {{else}}
      <fieldset>
        <legend>{{localize "DMEMU.Campaign.App.ActiveLegend"}}</legend>
        <p class="hint">{{localize "DMEMU.Campaign.App.NoCampaignHint"}}</p>
      </fieldset>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if isSheetTab}}
  <div class="dmemu-plot-panel">
    <div class="dmemu-plot-sheet-stack">
      <fieldset>
        <legend>{{localize "DMEMU.Plot.App.OpenLegend"}}</legend>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-plot-select-sheet">{{localize "DMEMU.Plot.App.Existing"}}</label>
          <div class="dmemu-plot-control-row">
            <select id="dmemu-plot-select-sheet" name="sheetSelect">
              <option value="">{{localize "DMEMU.Plot.App.SelectPlaceholder"}}</option>
              {{#each sheetList}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <button type="button" data-action="openCreateDialog" data-tooltip="{{localize "DMEMU.Plot.App.NewSheet"}}" aria-label="{{localize "DMEMU.Plot.App.NewSheet"}}">
              <i class="fas fa-plus"></i>
            </button>
          </div>
        </div>
      </fieldset>

      {{#if hasSheet}}
      <fieldset>
        <legend>{{localize "DMEMU.Plot.App.SheetLegend"}}</legend>
        <div class="dmemu-plot-name-type-row">
          <div class="form-group dmemu-plot-field">
            <label for="dmemu-plot-name">{{localize "DMEMU.Plot.App.Name"}}</label>
            <input id="dmemu-plot-name" type="text" name="sheetName" value="{{name}}" />
          </div>
          <div class="form-group dmemu-plot-field">
            <label for="dmemu-plot-type">{{localize "DMEMU.Plot.App.SheetType"}}</label>
            <div class="dmemu-plot-control-row">
              <select id="dmemu-plot-type" name="sheetType">
                {{#each sheetTypes}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <button type="button" data-action="changeType">{{localize "DMEMU.Plot.App.ApplyType"}}</button>
            </div>
          </div>
        </div>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-plot-scope">{{localize "DMEMU.Plot.App.Scope"}}</label>
          <textarea id="dmemu-plot-scope" name="scope" rows="4" placeholder="{{localize "DMEMU.Plot.App.ScopePlaceholder"}}">{{scope}}</textarea>
          <p class="hint">{{localize "DMEMU.Plot.App.ScopeHint"}}</p>
        </div>
        <div class="form-group dmemu-plot-field">
          <label for="dmemu-plot-mission">{{localize "DMEMU.Plot.App.Mission"}}</label>
          <textarea id="dmemu-plot-mission" name="mission" rows="3" placeholder="{{localize "DMEMU.Plot.App.MissionPlaceholder"}}">{{mission}}</textarea>
          <p class="hint">{{localize "DMEMU.Plot.App.MissionHint"}}</p>
        </div>
        <div class="dmemu-oracle-actions dmemu-plot-sheet-save">
          <button type="button" data-action="saveSheet">
            <i class="fas fa-save"></i> {{localize "DMEMU.Plot.App.Save"}}
          </button>
        </div>
      </fieldset>
      {{else}}
      <fieldset>
        <legend>{{localize "DMEMU.Plot.App.SheetLegend"}}</legend>
        <p class="hint">{{localize "DMEMU.Plot.App.NoSheetHint"}}</p>
      </fieldset>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if isPlayTab}}
  <div class="dmemu-plot-panel">
    <fieldset>
      <legend>{{localize "DMEMU.Plot.App.BeatsLegend"}}</legend>
      <p class="hint">{{localize "DMEMU.Plot.App.BeatsHint"}}</p>
      <div class="dmemu-oracle-actions">
        <button type="button" data-action="randomPrompt" data-tooltip="{{localize "DMEMU.Plot.App.RandomPromptTooltip"}}">
          <i class="fas fa-dice"></i> {{localize "DMEMU.Plot.Beat.RandomPrompt"}}
        </button>
        <button type="button" data-action="modifiedProposal" data-tooltip="{{localize "DMEMU.Plot.App.ModifiedProposalTooltip"}}">
          <i class="fas fa-random"></i> {{localize "DMEMU.Plot.Beat.ModifiedProposal"}}
        </button>
        {{#if hasTrack}}
        <button type="button" data-action="confirmAdvance" data-tooltip="{{localize "DMEMU.Plot.App.ConfirmAdvanceTooltip"}}">
          <i class="fas fa-forward"></i> {{localize "DMEMU.Plot.App.ConfirmAdvance"}}
        </button>
        {{/if}}
        <button type="button" data-action="saveSheet">
          <i class="fas fa-save"></i> {{localize "DMEMU.Plot.App.Save"}}
        </button>
      </div>
    </fieldset>

    {{#if hasTrack}}
    <fieldset>
      <legend>{{localize "DMEMU.Plot.App.TrackLegend"}}</legend>
      <p class="hint">{{trackProgress}}</p>
      <div class="dmemu-plot-track">
        {{#each trackBoxes}}
        {{#if isSectionStart}}
        <span class="dmemu-plot-track-section">{{sectionLabel}}</span>
        {{/if}}
        <button type="button" class="dmemu-plot-box {{#if checked}}checked{{/if}}" data-action="toggleBox" data-index="{{index}}" aria-pressed="{{checked}}">
          {{#if checked}}✓{{else}}{{label}}{{/if}}
        </button>
        {{/each}}
      </div>
    </fieldset>
    {{else}}
    <p class="hint">{{localize "DMEMU.Plot.App.NoTrackHint"}}</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if isNodesTab}}
  <div class="dmemu-plot-panel">
    {{#if hasStash}}
    <p class="hint dmemu-plot-stash">{{localize "DMEMU.Plot.App.StashHint"}} <em>{{stashPreview}}</em></p>
    {{/if}}
    <div class="dmemu-plot-nodes-grid">
      {{#each nodeCategories}}
      <fieldset class="dmemu-plot-nodes">
        <legend>{{label}}</legend>
        {{#each slots}}
        <div class="dmemu-plot-slot {{#if highlighted}}highlighted{{/if}}">
          <input type="text" name="node-{{categoryId}}-{{slotIndex}}" value="{{text}}" placeholder="{{localize "DMEMU.Plot.App.SlotPlaceholder"}}" />
          <button type="button" data-action="pasteStash" data-category-id="{{categoryId}}" data-slot-index="{{slotIndex}}" data-tooltip="{{localize "DMEMU.Plot.App.PasteStashTooltip"}}" {{#unless @root.hasStash}}disabled{{/unless}}>
            <i class="fas fa-paste"></i>
          </button>
          <button type="button" data-action="clearSlot" data-category-id="{{categoryId}}" data-slot-index="{{slotIndex}}" data-tooltip="{{localize "DMEMU.Plot.App.ClearSlotTooltip"}}">
            <i class="fas fa-times"></i>
          </button>
        </div>
        {{/each}}
      </fieldset>
      {{/each}}
    </div>
    <div class="dmemu-oracle-actions dmemu-plot-nodes-save">
      <button type="button" data-action="saveSheet">
        <i class="fas fa-save"></i> {{localize "DMEMU.Plot.App.Save"}}
      </button>
    </div>
  </div>
  {{/if}}
</section>
